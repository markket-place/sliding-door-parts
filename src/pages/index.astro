---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const [stores, products] = await Promise.all([
  getCollection("stores"),
  getCollection("products"),
]);

const store = stores[0];

if (!store) {
  throw new Error("Store not found. Check PUBLIC_STORE_SLUG.");
}

const storeData = store.data;

const getImage = (media: any) => {
  if (!media) return null;
  const url = media.formats?.medium?.url || media.url;
  if (!url) return null;
  return url.startsWith("https") ? url : `/${url}`;
};

const formatPrice = (price: number | string) =>
  new Intl.NumberFormat("en-US", {
    style: "currency",
    currency: "USD",
    maximumFractionDigits: 2,
  }).format(Number(price));

const description =
  storeData.description ||
  "Friendliest sliding door parts in NoHo\n\nSliding Door parts for contractors and resellers";

const descParagraphs =
  typeof description === "string"
    ? description.split(/\n\s*\n|\n/).filter((line) => line.trim().length > 0)
    : [description];
---

<Layout
  title={(storeData?.seo as any)?.metaTitle ||
    `${storeData?.title} | Architectural Hardware`}
  seo={{
    page_description: (storeData.seo as any)?.metaDescription || description,
    featured_image: getImage(storeData?.cover || storeData.logo),
    featured_image_alt: storeData.title as string,
    canonical_url: `${storeData.slug}.markket.place`,
    no_index: false,
    open_graph_type: "website",
    author_twitter_handle: "",
  }}
>
  <main
    class="min-h-screen bg-[#faf8f5] text-stone-900 font-sans selection:bg-stone-900 selection:text-stone-100"
  >
    <!-- Top Utility Bar -->
    <div
      class="border-b border-stone-200/80 bg-white/60 backdrop-blur px-6 py-2.5 text-xs font-mono text-stone-500 flex flex-wrap justify-between items-center gap-2"
    >
      <div class="flex items-center gap-2 tracking-wide">
        <span
          class="font-medium text-stone-800 uppercase tracking-widest text-[10px]"
        >
          ^__^
        </span>
        <span class="text-stone-300">/</span>
      </div>
    </div>

    <!-- Hero Header -->
    <section class="max-w-6xl mx-auto px-6 pt-16 pb-14 sm:pt-24 sm:pb-20">
      <div class="max-w-3xl space-y-6">
        <p class="font-mono text-xs uppercase tracking-widest text-stone-500">
          {store.data.title || "Sliding Hardware"}
        </p>

        <h1
          class="text-4xl sm:text-6xl font-light tracking-tight text-stone-950 font-serif leading-[1.08]"
        >
          Wholesale Lux
        </h1>

        <!-- Dynamic Description -->
        <div
          class="text-stone-600 text-base sm:text-lg leading-relaxed space-y-2 pt-2 border-l border-stone-300 pl-4"
        >
          {
            descParagraphs.map((paragraph, i) => (
              <p
                class={
                  i === 0 ? "text-stone-900 font-medium" : "text-stone-600"
                }
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <div class="pt-4">
          <a
            href="#collection"
            class="inline-flex items-center gap-2 px-6 py-3.5 bg-stone-900 hover:bg-stone-800 text-stone-100 text-xs font-mono tracking-widest uppercase transition-colors"
          >
            Explore Catalogue <span>↓</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Catalogue Section -->
    <section class="max-w-6xl mx-auto px-6 pb-24" id="collection">
      <div
        class="flex flex-row justify-between items-end pb-4 mb-8 border-b border-stone-200"
      >
        <div>
          <span
            class="font-mono text-[11px] text-stone-400 uppercase tracking-widest block mb-1"
          >
            Catalogue
          </span>
          <h2 class="text-xl sm:text-2xl font-serif font-normal text-stone-900">
            Latest Updates
          </h2>
        </div>
        <span class="font-mono text-xs text-stone-400">
          more than {products.length} items
        </span>
      </div>

      {
        products.length > 0 ? (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-12">
            {products.map(({ data }, index) => {
              const image = getImage(data.thumbnail);
              const price = data.usd_price ?? (data.prices as any)?.[0]?.price;
              const title =
                data.name || (data.seo as any)?.metaTitle || "Products";
              const productSlug = data.slug;
              console.log({
                index,
                name: data.name,
                _______________________id: data.documentId,
              });
              const partDesc =
                (data.seo as any)?.metaDescription ||
                (data as any)?.description ||
                "";

              return (
                <article class="group flex flex-col justify-between space-y-4">
                  <a
                    class="block aspect-[4/3] bg-stone-200/60 overflow-hidden relative"
                    href={
                      productSlug ? `/products/${productSlug}/` : "#collection"
                    }
                  >
                    {image ? (
                      <img
                        src={image}
                        alt={(data.thumbnail as any)?.alternativeText || title}
                        loading="lazy"
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center font-mono text-xs text-stone-400">
                        No Preview
                      </div>
                    )}
                  </a>

                  <div class="space-y-2">
                    <div class="flex justify-between items-baseline gap-4">
                      <h3 class="font-serif text-lg font-normal text-stone-900 group-hover:text-stone-600 transition-colors">
                        <a
                          href={
                            productSlug
                              ? `/products/${productSlug}/`
                              : "#collection"
                          }
                        >
                          {title}
                        </a>
                      </h3>
                      <strong class="font-mono text-sm font-semibold text-stone-900 whitespace-nowrap">
                        {price != null ? formatPrice(price) : "Inquire"}
                      </strong>
                    </div>

                    {partDesc && (
                      <p class="text-xs text-stone-500 line-clamp-2 leading-relaxed">
                        {partDesc}
                      </p>
                    )}

                    {productSlug && (
                      <div class="pt-1">
                        <a
                          href={`/products/${productSlug}/`}
                          class="font-mono text-[11px] text-stone-500 hover:text-stone-950 uppercase tracking-wider inline-flex items-center gap-1 transition-colors"
                        >
                          View details <span class="text-xs">↗</span>
                        </a>
                      </div>
                    )}
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="py-16 text-center font-mono text-xs text-stone-500 border border-dashed border-stone-300">
            Catalog currently updating. Check back shortly.
          </div>
        )
      }
    </section>

    <!-- Closing Section -->
    <section class="border-t border-stone-200 bg-stone-100 px-6 py-20">
      <div class="max-w-2xl mx-auto text-center space-y-6">
        <p class="font-mono text-xs text-stone-400 uppercase tracking-widest">
          {(storeData.seo as any)?.metaTitle || storeData.title}
        </p>

        <div
          class="text-stone-700 font-serif text-xl sm:text-2xl leading-relaxed whitespace-pre-line"
        >
          {description}
        </div>

        <div class="pt-4">
          <a
            class="inline-block px-7 py-3.5 bg-stone-900 hover:bg-stone-800 text-stone-100 font-mono text-xs uppercase tracking-widest transition-colors"
            href="/contact/"
          >
            Get In Touch
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
