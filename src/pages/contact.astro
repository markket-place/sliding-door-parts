---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";

const stores = await getCollection("stores");
const store = stores[0];

if (!store) {
  throw new Error("Store not found");
}

const storeData = store.data;
const storeName = storeData.title || "Our store";
const storeDescription = storeData.description || "";
const email = `${storeData.slug}@markket.place`;
---

<Layout title={`Contact | ${storeName}`}>
  <main class="contact-page">
    <section class="contact-intro">
      <p class="eyebrow">A note from the warehouse</p>
      <h1>Good things start<br />with a conversation.</h1>

      <p class="intro-copy">
        Questions about an item, a bulk order, or something you spotted? We'd
        love to hear from you.
      </p>
    </section>

    <section class="contact-card">
      <div class="contact-description">
        <p class="eyebrow">A little about us</p>
        <h2>{storeName}.</h2>
        <p class="description">{storeDescription}</p>
      </div>

      <div class="contact-details">
        <p class="eyebrow">Get in touch</p>
        <a class="email" href={`/contact`}>{email}</a>
        <p class="small-copy">
          Send us a note and we'll get back to you as soon as we can.
        </p>
        <a
          class="contact-button"
          href={`mailto:${email}?subject=${encodeURIComponent(`Hello, ${storeName}`)}`}
        >
          Write us an email <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <p class="closing-note">
      Independently curated. Powered by <a href="https://markket.place">
        Markkët
      </a>.
    </p>
  </main>
</Layout>

<style>
  .contact-page {
    max-width: 1100px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    color: #29291f;
  }

  .contact-intro {
    max-width: 720px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: #77765e;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  h1 {
    margin: 0;
    font-size: clamp(3rem, 7vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .intro-copy {
    max-width: 460px;
    margin: 1.75rem auto 0;
    color: #747365;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .contact-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border: 1px solid #e5e2d5;
    border-radius: 5px;
    background: #f7f6ef;
  }

  .contact-description,
  .contact-details {
    padding: clamp(2rem, 5vw, 4rem);
  }

  .contact-description {
    border-right: 1px solid #e5e2d5;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: 2.5rem;
    letter-spacing: -0.04em;
  }

  .description {
    margin: 0;
    color: #6f6e60;
    font-size: 1rem;
    line-height: 1.9;
    white-space: pre-line;
  }

  .email {
    display: inline-block;
    margin: 0.25rem 0 1rem;
    color: #333426;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.35rem, 3vw, 2rem);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  .small-copy {
    max-width: 300px;
    color: #77765e;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.5rem;
    padding: 0.95rem 1.3rem;
    border-radius: 2px;
    background: #454735;
    color: #fff;
    font-size: 0.85rem;
    text-decoration: none;
    transition: background 160ms ease;
  }

  .contact-button:hover {
    background: #29291f;
  }

  .closing-note {
    margin: 2rem 0 0;
    color: #969486;
    font-size: 0.8rem;
    text-align: center;
  }

  .closing-note a {
    color: #65654f;
    text-decoration: none;
  }

  .closing-note a:hover {
    text-decoration: underline;
  }

  @media (max-width: 700px) {
    .contact-page {
      padding: 3.5rem 1.25rem 4rem;
    }

    .contact-intro {
      margin-bottom: 2.5rem;
    }

    .contact-card {
      grid-template-columns: 1fr;
    }

    .contact-description {
      border-right: 0;
      border-bottom: 1px solid #e5e2d5;
    }
  }
</style>
